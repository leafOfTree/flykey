{
  "manifest_version": 3,
  "name": "Flykey",
  "version": "1.2.1",
  "description": "用 Vim 风格快捷键高效浏览网页、切换标签页、搜索历史记录和添加书签。",
  "minimum_chrome_version": "99",
  "permissions": [
    "activeTab",
    "bookmarks",
    "clipboardWrite",
    "favicon",
    "history",
    "sessions",
    "storage"
  ],
  "background": {
    "service_worker": "common/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frontend/dist/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"],
      "extension_ids": ["*"]
    }
  ],
  "action": {
    "default_title": "Flykey",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "128": "icon/128.png"
    }
  },
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  }
}
